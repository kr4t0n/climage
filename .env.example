# Local publishing credentials. Copy to .env — .env is git-ignored and must
# never be committed. CI reads the same values from GitHub Actions secrets.

# Docker Hub account that owns the repository.
DOCKERHUB_USERNAME=your-dockerhub-username

# Docker Hub access token (Account Settings -> Personal access tokens).
# Use a token scoped to Read & Write, not your account password.
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Image coordinates.
IMAGE_NAME=climage
IMAGE_TAG=dev
